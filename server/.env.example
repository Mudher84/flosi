PORT=8080
FLOSI_ANDROID_PACKAGE=com.flosi.app
GOOGLE_APPLICATION_CREDENTIALS=/secure/google-play-service-account.json

# ZainCash v2: keep these ONLY on the server.
ZAINCASH_BASE_URL=https://pg-api-uat.zaincash.iq
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_API_KEY=
ZAINCASH_SERVICE_TYPE=
ZAINCASH_SUCCESS_URL=https://api.example.com/v1/zaincash/redirect/success
ZAINCASH_FAILURE_URL=https://api.example.com/v1/zaincash/redirect/failure

# Optional shared allowlist for the Android app/backend deployment.
FLOSI_ALLOWED_ORIGIN=
